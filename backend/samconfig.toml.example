# Example AWS SAM CLI configuration file
# Copy this to `samconfig.toml` when ready to deploy (remember: samconfig.toml is git-ignored)
version = 0.1

[default]
[default.global.parameters]
stack_name = "aerodispatch-backend-dev"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "aerodispatch-backend-dev"
region = "ap-south-1"  # Default AWS region (e.g. Mumbai ap-south-1)
image_repositories = []
