# ==============================================================================
# AeroDispatch Backend Security Configuration Template
# COPY THIS FILE TO .env AND GENERATE STRONG CRYPTOGRAPHIC SECRETS FOR PRODUCTION
# ==============================================================================

# Application Environment (development | staging | production)
AERODISPATCH_ENV=development

# JWT Authentication Secrets (Must be at least 32 characters in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=aerodispatch-jwt-access-secret-32chars-minimum-prod-key-2026
JWT_REFRESH_SECRET=aerodispatch-jwt-refresh-secret-32chars-minimum-prod-key-2026

# Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (Set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# File Upload Storage
UPLOADS_BUCKET_NAME=aerodispatch-proofs-local
